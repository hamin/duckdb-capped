query I
SELECT path FROM capped_status('e2e', 'ti') WHERE sealed
----
ti/0.frag-000008.parquet

query I
SELECT count(*) FROM e2e.main.ti
----
8

# age past the 1-second ttl (~2 s of single-threaded work), then evict
statement ok
SET threads = 1

query I
SELECT count(DISTINCT hash(range)) > 0 FROM range(12000000)
----
1

query I
SELECT count(DISTINCT hash(range)) > 0 FROM range(12000000)
----
1

