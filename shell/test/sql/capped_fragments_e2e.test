# name: test/sql/capped_fragments_e2e.test
# description: fragments end-to-end (open-segment fragments plan §5 T9): content
#              survives compaction and seal, disk files match the manifest, TTL
#              eviction of a fragmented ingest-time segment, fts across
#              merged-away fragments, blocked commits leave nothing behind, and
#              names occupied on disk never wedge a commit
# group: [sql]

require capped

require parquet

statement ok
LOAD fts

statement ok
LOAD vss

# One store, no background thread: every sweep, seal and eviction lands
# exactly where a statement puts it.

statement ok
ATTACH '__TEST_DIR__/capped_e2e' AS e2e (TYPE capped, enforce_interval '0')

# ---------------------------------------------------------------------------
# (a) 50 single-row commits: every row present, the open segment stays
#     within the 32-fragment cap, and the .parquet files on disk are exactly
#     what the manifest references — sealed paths + live fragments + the
#     still-graced pending deletes (all queued under the default 5-minute
#     grace, so none has been swept). Checked before and after a seal.
# ---------------------------------------------------------------------------

