CREATE TEMP TABLE tc_hash AS SELECT sum(hash(ts, msg, x)) AS h FROM e2e.main.tc

statement ok
SELECT * FROM capped_seal('e2e', 'tc')

query I
SELECT ((SELECT sum(hash(ts, msg, x)) FROM e2e.main.tc) = (SELECT h FROM tc_hash))::INTEGER
----
1

query I
SELECT (s.rows = (SELECT count(*) FROM e2e.main.tc) AND
        s.min_ts_us = (SELECT epoch_ns(min(ts))::BIGINT // 1000 FROM e2e.main.tc) AND
        s.max_ts_us = (SELECT epoch_ns(max(ts))::BIGINT // 1000 FROM e2e.main.tc))::INTEGER
FROM capped_status('e2e', 'tc') s WHERE s.sealed
----
1

# ---------------------------------------------------------------------------
# (d) ingest-time table (no time column, hidden _ingest_ts): fragments, the
#     8-merge, a seal (single fragment adopted as-is at its fragment path),
#     then TTL eviction. The 1-second ttl ages by real time, so a busy wait
#     stands in for the clock; eviction drops the segment and removes its
#     file on the spot (the manifest swap is the commit; GC only chases
#     leftovers).
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE e2e.main.ti(x BIGINT) WITH (ttl='1 second')

statement ok
