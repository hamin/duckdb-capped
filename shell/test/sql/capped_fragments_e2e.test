# ---------------------------------------------------------------------------
# (f) on_violation => block: the rejected commit errors and leaves NO
#     fragment file and NO .flush temp behind — the hard cap throws before
#     publication, so the seq the rejected commit would have used stays
#     unbuilt (max_rows is a total cap, so no further commit is accepted).
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE e2e.main.tb(x BIGINT) WITH (max_rows='3', on_violation='block')

