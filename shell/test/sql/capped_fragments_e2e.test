query I
SELECT count(*) FROM e2e.main.th
----
18

query I
SELECT sum(x) FROM e2e.main.th
----
171

# the blocker is still on disk (GC only ever removes regular files; glob()
# itself only sees files, so the recursive ** reaches into the planted dir)
query I
SELECT count(*) FROM glob('__TEST_DIR__/capped_e2e/th/0.frag-000008.parquet/**')
----
1

# ---------------------------------------------------------------------------
# (i) stray FILE at the next fragment path: plant a small parquet named
#     <open_id>.frag-<next seq>.parquet, the commit succeeds (it routes to
#     the next free seq and burns the planted one), the stray file is
#     untouched by the commit, and it is collected by GC on a later ATTACH
#     once capped_pending_delete_grace = '0s' drops the age floor. That same
#     sweep keeps every manifest-referenced file: the adopted user file
#     survives byte-identical, the blocker directory survives (directories
#     are never GC candidates), and the pending deletes queued earlier under
#     the default grace are not yet due, so they survive too.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE e2e.main.i1(x BIGINT) WITH (max_bytes='1GB')

statement ok
INSERT INTO e2e.main.i1 VALUES (1)

statement ok
COPY (SELECT 42::BIGINT AS x) TO '__TEST_DIR__/capped_e2e/i1/0.frag-000001.parquet' (FORMAT parquet)

statement ok
CREATE TEMP TABLE stray_md5 AS SELECT md5(content) AS m FROM read_blob('__TEST_DIR__/capped_e2e/i1/0.frag-000001.parquet')

statement ok
INSERT INTO e2e.main.i1 VALUES (2)

# the commit succeeded, its fragment landed at seq 2 (seq 1 was skipped),
# and the stray file is exactly as planted
query I
SELECT count(*) FROM e2e.main.i1
----
2

query I
SELECT sum(x) FROM e2e.main.i1
----
3

query I
SELECT count(*) FROM glob('__TEST_DIR__/capped_e2e/i1/0.frag-000002.parquet')
----
1

query I
SELECT (md5(content) = (SELECT m FROM stray_md5))::INTEGER
FROM read_blob('__TEST_DIR__/capped_e2e/i1/0.frag-000001.parquet')
----
1

# a later ATTACH runs the sweep; with the grace at zero the unreferenced
# stray is collected immediately, while owned files are left alone
statement ok
SET capped_pending_delete_grace = '0s'

statement ok
ATTACH '__TEST_DIR__/capped_e2e' AS e2eb (TYPE capped, enforce_interval '0')

query I
SELECT count(*) FROM e2eb.main.i1
----
2

query I
SELECT count(*) FROM glob('__TEST_DIR__/capped_e2e/i1/0.frag-000001.parquet')
----
0

# the adopted user file survived the sweep untouched
query I
SELECT (md5(content) = (SELECT m FROM g_md5))::INTEGER
FROM read_blob('__TEST_DIR__/capped_e2e/g1/9.seg.parquet')
----
1

# directories are never GC candidates, so the (h) blocker stays — and later
# merges keep routing around it — while the pending deletes queued earlier
# under the default 5-minute grace are not yet due and survive as well
query I
SELECT count(*) FROM glob('__TEST_DIR__/capped_e2e/th/0.frag-000008.parquet/**')
----
1

query I
SELECT count(*) FROM glob('__TEST_DIR__/capped_e2e/th/0.frag-000000.parquet')
----
1

statement ok
SET capped_pending_delete_grace = '5min'
