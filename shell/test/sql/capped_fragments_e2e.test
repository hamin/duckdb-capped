statement ok
INSERT INTO e2e.main.ti VALUES (5)

statement ok
INSERT INTO e2e.main.ti VALUES (6)

statement ok
INSERT INTO e2e.main.ti VALUES (7)

statement ok
INSERT INTO e2e.main.ti VALUES (8)

statement ok
SELECT * FROM capped_seal('e2e', 'ti')

