# the .parquet files on disk are exactly the sealed segment paths, the live
# fragments of the open segment, and the still-graced pending deletes
query I
SELECT (((SELECT count(*) FROM glob('__TEST_DIR__/capped_e2e/t50/*.parquet')
          WHERE file NOT LIKE '%/.flush-%')
         = (SELECT count(*) FROM capped_status('e2e', 't50') WHERE sealed)
           + (SELECT fragments FROM capped_tables('e2e') WHERE table_name = 't50')
           + (SELECT pending_delete_files FROM capped_tables('e2e') WHERE table_name = 't50'))
        )::INTEGER
----
1

