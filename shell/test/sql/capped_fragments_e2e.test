# ---------------------------------------------------------------------------
# (h) occupied merge output, recovery (needs the T9 skip fix): a DIRECTORY
#     at the merge output path would block every later commit, because the
#     manifest consumes a seq only when it lands and the next commit would
#     retry the same name forever. With the fix the merge reroutes to the
#     next free seq, records a maintenance failure, and the commits keep
#     succeeding; nothing is lost or duplicated. GC never collects
#     directories, so the blocker itself survives a later ATTACH — the merge
#     simply routes around it.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE e2e.main.th(x BIGINT) WITH (max_bytes='1GB')

statement ok
INSERT INTO e2e.main.th VALUES (1)

statement ok
INSERT INTO e2e.main.th VALUES (2)

statement ok
INSERT INTO e2e.main.th VALUES (3)

statement ok
INSERT INTO e2e.main.th VALUES (4)

statement ok
INSERT INTO e2e.main.th VALUES (5)

statement ok
INSERT INTO e2e.main.th VALUES (6)

statement ok
INSERT INTO e2e.main.th VALUES (7)

# the first merge fires on the 8th commit and would output seq 8 — plant a
# directory there (a partitioned COPY, which touches no fragment a scan reads)
statement ok
COPY (SELECT 1 AS p, 'x' AS v) TO '__TEST_DIR__/capped_e2e/th/0.frag-000008.parquet' (FORMAT parquet, PARTITION_BY (p))

statement ok
INSERT INTO e2e.main.th VALUES (8)

query IT
SELECT maintenance_failures, COALESCE(last_maintenance_error, '<none>') FROM capped_tables('e2e') WHERE table_name = 'th'
----
1	fragment compaction: path th/0.frag-000008.parquet is occupied on disk; wrote the merge output under seq 9

# commits keep succeeding past the blocked name
