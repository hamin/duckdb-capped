statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 120)

query I
SELECT count(*) FROM cts.main.mix
----
40

query I
SELECT sum(v) FROM cts.main.mix
----
2420

query I
SELECT ((SELECT sum(hash(v)) FROM cts.main.mix) =
        ((SELECT sum(hash(CAST(range AS BIGINT))) FROM range(1, 21)) +
         (SELECT sum(hash(CAST(range AS BIGINT))) FROM range(101, 121))))::INTEGER
----
1
