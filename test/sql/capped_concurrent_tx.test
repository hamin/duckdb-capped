# name: test/sql/capped_concurrent_tx.test
# description: overlapping transactions from separate connections must not clobber each other
# group: [sql]

# Each connection gets its own transaction from the manager. With a single
# ownership slot (the M14 bug), conB's start destroyed conA's still-live
# transaction, and conA's COMMIT then flushed freed buffers — SIGSEGV in
# CappedTransaction::FlushAll under concurrent OTLP ingest + sealer.

require capped

require parquet

statement ok
ATTACH '__TEST_DIR__/capped_cts_store' AS cts (TYPE capped)

statement ok
CREATE TABLE cts.main.logs(ts TIMESTAMPTZ, body VARCHAR) WITH (time_col='ts', ttl='36500 days', max_bytes='1GB')

statement ok conA
BEGIN

statement ok conA
INSERT INTO cts.main.logs VALUES (TIMESTAMPTZ '2026-11-01 00:00:00+00', 'a')

statement ok conB
BEGIN

statement ok conB
INSERT INTO cts.main.logs VALUES (TIMESTAMPTZ '2026-11-01 00:00:01+00', 'b')

statement ok conA
COMMIT

statement ok conB
COMMIT

query I
SELECT count(*) FROM cts.main.logs
----
2

# rollback path: conA's discarded rows must not leak, and must not take conB
# (whose transaction overlaps conA's) down with them
statement ok conA
BEGIN

statement ok conA
INSERT INTO cts.main.logs VALUES (TIMESTAMPTZ '2026-11-01 00:00:02+00', 'dropped')

statement ok conB
BEGIN

statement ok conA
ROLLBACK

statement ok conB
COMMIT

query I
SELECT count(*) FROM cts.main.logs
----
2

query I
SELECT count(*) FROM cts.main.logs WHERE body = 'dropped'
----
0

# --- fragments under interleaved commits ------------------------------------
# Two connections interleave single-row autocommit INSERTs on one fragment
# table (20 each — enough to fire compaction merges on the shared open
# segment) while conB seals it midway: nothing may be lost or duplicated.

statement ok
CREATE TABLE cts.main.mix(ts TIMESTAMPTZ, v BIGINT) WITH (time_col='ts', ttl='36500 days', max_bytes='1GB')

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 1)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 101)

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 2)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 102)

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 3)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 103)

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 4)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 104)

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 5)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 105)

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 6)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 106)

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 7)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 107)

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 8)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 108)

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 9)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 109)

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 10)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 110)

# seal from conB while conA keeps committing
statement ok conB
SELECT * FROM capped_seal('cts', 'mix')

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 11)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 111)

statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 12)

statement ok conB
