statement ok conA
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 18)

statement ok conB
INSERT INTO cts.main.mix VALUES (TIMESTAMPTZ '2026-11-02 00:00:01+00', 118)

statement ok conA
