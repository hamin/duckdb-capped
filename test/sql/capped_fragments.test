query II
SELECT count(*), sum(x) FROM cf.main.t32
----
1300	845650

# the trigger really rotated the segment: sealed segments exist, and no
# maintenance ever failed on this table
query I
SELECT (count(*) > 0)::INTEGER FROM capped_status('cf','t32') WHERE sealed
----
1

query IT
SELECT maintenance_failures, COALESCE(last_maintenance_error, '<none>') FROM capped_tables('cf') WHERE table_name = 't32'
----
0	<none>

# ---------------------------------------------------------------------------
# Post-commit maintenance failures stay visible: block the next merge output
# (tfail/0.frag-000008.parquet becomes a DIRECTORY via a partitioned COPY,
# which touches none of the fragment files a scan reads), then commit the
# row whose flush triggers that merge. The INSERT must succeed anyway, the
# rows stay readable, and capped_tables reports the failure.
# ---------------------------------------------------------------------------

statement ok
CREATE TABLE cf.main.tfail(x BIGINT) WITH (max_bytes='1GB')

statement ok
INSERT INTO cf.main.tfail VALUES (1)

statement ok
INSERT INTO cf.main.tfail VALUES (2)

statement ok
INSERT INTO cf.main.tfail VALUES (3)

statement ok
INSERT INTO cf.main.tfail VALUES (4)

statement ok
INSERT INTO cf.main.tfail VALUES (5)

statement ok
INSERT INTO cf.main.tfail VALUES (6)

statement ok
INSERT INTO cf.main.tfail VALUES (7)

query IT
SELECT maintenance_failures, COALESCE(last_maintenance_error, '<none>') FROM capped_tables('cf') WHERE table_name = 'tfail'
----
0	<none>

# the first merge fires on the 8th commit and outputs seq 8
statement ok
COPY (SELECT 1 AS p, 'x' AS v) TO '__TEST_DIR__/capped_frag_store/tfail/0.frag-000008.parquet' (FORMAT parquet, PARTITION_BY (p))

statement ok
INSERT INTO cf.main.tfail VALUES (8)

query II
SELECT count(*), sum(x) FROM cf.main.tfail
----
8	36

query II
SELECT (maintenance_failures >= 1)::INTEGER, (length(last_maintenance_error) > 0)::INTEGER FROM capped_tables('cf') WHERE table_name = 'tfail'
----
1	1

