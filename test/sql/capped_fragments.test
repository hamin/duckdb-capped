# name: test/sql/capped_fragments.test
# description: open-segment fragments: file-count seal trigger (MAX_OPEN_FRAGMENTS)
#              and visible post-commit maintenance failures
# group: [sql]

require capped

require parquet

# ---------------------------------------------------------------------------
# MAX_OPEN_FRAGMENTS (32): with only a byte cap and the hidden ingest time,
# should_seal never fires for a small table; the file-count seal alone keeps
# the open segment bounded. Compaction drains tier-0/1 runs, so it is the
# tier-2 accumulation that drives the live file count to the cap: the first
# rotation fires between commit 1200 and 1300 here (T2's simulation saw
# ~1111 commits per segment), hence 1300 single-row commits (one fragment,
# one transaction each). Every 10 commits the published manifest must hold
# <= 32 fragment files.
# ---------------------------------------------------------------------------

statement ok
ATTACH '__TEST_DIR__/capped_frag_store' AS cf (TYPE capped)

statement ok
CREATE TABLE cf.main.t32(x BIGINT) WITH (max_bytes='1GB')

query IT
SELECT maintenance_failures, COALESCE(last_maintenance_error, '<none>') FROM capped_tables('cf') WHERE table_name = 't32'
----
0	<none>

statement ok
INSERT INTO cf.main.t32 VALUES (1)

